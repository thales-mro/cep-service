{
  "uid": "cep-service",
  "title": "CEP Service",
  "tags": ["cep-service"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consultas por resultado (por segundo)",
      "description": "Origem da resposta: base prioritária, ViaCEP, BrasilAPI, não encontrado ou falha de provedor.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(cep_lookups_total[1m]))", "legendFormat": "{{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência p95 da busca de CEP",
      "description": "Tempo de resposta do endpoint GET /api/v1/ceps/{cep}.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/ceps/{cep}\"}[1m])))", "legendFormat": "p95" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/ceps/{cep}\"}[1m])))", "legendFormat": "p50" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência p95 dos provedores externos",
      "description": "Tempo das chamadas à ViaCEP e à BrasilAPI.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, client_name) (rate(http_client_requests_seconds_bucket[1m])))", "legendFormat": "{{client_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Respostas HTTP por status (por segundo)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=~\"/api/.*\"}[1m]))", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log assíncrono: gravados x falhas de publicação",
      "description": "Logs gravados pelo consumidor Kafka e eventos que não chegaram ao broker.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(cep_lookup_logs_saved_total[1m])", "legendFormat": "logs gravados" },
        { "refId": "B", "expr": "rate(cep_lookup_events_publish_failures_total[1m])", "legendFormat": "falhas de publicação" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memória heap da JVM",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap usado" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Kafka",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Kafka: mensagens produzidas x consumidas (por segundo)",
      "description": "Eventos publicados no tópico cep-lookups e lidos pelo consumidor do log. As duas linhas juntas indicam que o consumidor acompanha o ritmo.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(kafka_producer_topic_record_send_total{topic=\"cep-lookups\"}[1m]))", "legendFormat": "produzidas" },
        { "refId": "B", "expr": "sum(rate(kafka_consumer_fetch_manager_records_consumed_total[1m]))", "legendFormat": "consumidas" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Kafka: lag do consumidor por partição",
      "description": "Mensagens já publicadas que o consumidor ainda não leu. Perto de zero: o log está em dia. Crescendo: o consumidor não dá conta (ou está fora do ar, quando a métrica some).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (partition) (kafka_consumer_fetch_manager_records_lag{topic=\"cep-lookups\"})", "legendFormat": "partição {{partition}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kafka: tempo de envio e de processamento",
      "description": "Envio: chamada ao KafkaTemplate na busca. Processamento: consumidor gravando o log no banco (média e pior caso).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(spring_kafka_template_seconds_sum[1m])) / sum(rate(spring_kafka_template_seconds_count[1m]))", "legendFormat": "envio (média)" },
        { "refId": "B", "expr": "sum(rate(spring_kafka_listener_seconds_sum[1m])) / sum(rate(spring_kafka_listener_seconds_count[1m]))", "legendFormat": "processamento (média)" },
        { "refId": "C", "expr": "max(spring_kafka_listener_seconds_max)", "legendFormat": "processamento (máximo)" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Kafka: erros e dead letter (por segundo)",
      "description": "Falhas de envio do produtor, falhas do consumidor (antes das novas tentativas) e mensagens desviadas para cep-lookups-dlt. O normal é tudo em zero.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(kafka_producer_record_error_total[1m]))", "legendFormat": "erros de envio" },
        { "refId": "B", "expr": "sum(rate(spring_kafka_listener_seconds_count{result=\"failure\"}[1m])) or vector(0)", "legendFormat": "falhas do consumidor" },
        { "refId": "C", "expr": "sum(rate(kafka_producer_topic_record_send_total{topic=\"cep-lookups-dlt\"}[1m])) or vector(0)", "legendFormat": "enviadas para a DLT" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
